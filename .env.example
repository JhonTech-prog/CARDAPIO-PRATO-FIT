# URL pública do ERP PRATOFIT-ADMIN que expõe o cardápio e as reservas.
# Exemplo: https://erp.pratofit.com.br
VITE_ERP_API_URL=https://erp.example.com

# URL do backend deste cardápio, usada somente para registrar e abrir o cupom.
# Exemplo: http://localhost:3001
VITE_API_URL=http://localhost:3001

# MongoDB Connection String - SUBSTITUA COM SUA CONNECTION STRING REAL DO MONGODB
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/pratofit?retryWrites=true&w=majority

# Porta do servidor backend
PORT=3001
